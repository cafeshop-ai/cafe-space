    { "args": ["cancel", "session-fixture", "stream-fixture", "cwd-fixture", "run-fixture"], "request": { "method": "cancel", "params": { "sessionId": "session-fixture", "expectedStreamId": "stream-fixture", "expectedCwdFence": "cwd-fixture", "runId": "run-fixture" } } },

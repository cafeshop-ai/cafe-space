    { "args": ["new", "session-fixture", "project-fixture", "pi", "cwd-fixture", "--resume", "source-fixture"], "request": { "method": "create_session", "params": { "sessionId": "session-fixture", "projectId": "project-fixture", "runtimeId": "pi", "expectedCwdFence": "cwd-fixture", "start": { "mode": "resume", "params": { "sourceSessionId": "source-fixture" } } } } },

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Café Space",
  "version": "0.1.0",
  "identifier": "ai.cafeshop.cafe-space-dev",
  "build": {
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Café Space",
        "width": 1120,
        "height": 760,
        "minWidth": 320,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": false
  }
}

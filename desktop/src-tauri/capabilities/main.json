{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the bundled main window can forward bounded protocol frames to owner-only IPC.",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-daemon-open",
    "allow-daemon-send",
    "allow-daemon-ack",
    "allow-daemon-close",
    "allow-daemon-installation-info",
    "allow-daemon-install",
    "allow-daemon-start",
    "allow-daemon-update",
    "allow-daemon-cancel-update",
    "allow-daemon-recover",
    "allow-m0-finish",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" },
        { "url": "mailto:*" }
      ]
    }
  ]
}
